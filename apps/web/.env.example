# Base URL of services/api (REST + SSE). Used by reader (server + browser) and studio.
NEXT_PUBLIC_API_URL=http://localhost:8080
# 1 = serve data/fixtures/*.json with an in-memory studio store (no API needed). 0 = call the real API.
NEXT_PUBLIC_USE_FIXTURES=1
# Studio auth mode. "dev" sends x-dev-user; "firebase" is a TODO (see src/lib/auth/auth-provider.tsx).
NEXT_PUBLIC_AUTH_MODE=dev
NEXT_PUBLIC_DEV_USER=editor@dev
# Public origin used for share links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
