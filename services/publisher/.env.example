# @openlens/publisher — channel credentials.
# Local dev: copy to .env (gitignored). Prod (Cloud Run): inject each value from Secret Manager.
# A channel is "live" only when all of its required vars are set; otherwise it runs dry_run only.

# ---------- YouTube Data API v3 (OAuth2 refresh-token flow) ----------
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Default channel. Get one with: npm run youtube-auth -w @openlens/publisher
YOUTUBE_REFRESH_TOKEN=
# Optional per-tier channels (override the default for that tier):
YOUTUBE_REFRESH_TOKEN_REGIONAL=
YOUTUBE_REFRESH_TOKEN_NATIONAL=
YOUTUBE_REFRESH_TOKEN_INTERNATIONAL=
# private (default; unverified API projects force private anyway) | unlisted | public
YOUTUBE_PRIVACY_STATUS=private
# 25 = News & Politics
YOUTUBE_CATEGORY_ID=25
YOUTUBE_NOTIFY_SUBSCRIBERS=false

# ---------- X API v2 ----------
# Either OAuth 1.0a user context (preferred: tokens don't expire)...
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
# ...or an OAuth 2.0 user-context token with tweet.write (expires after ~2h unless refreshed)
X_OAUTH2_USER_TOKEN=
# Attach the video via media upload (needs a tier with media write). Off = text + link only.
X_MEDIA_UPLOAD=false
# Optional: used to build post URLs (defaults to x.com/i/status/<id>)
X_USERNAME=
X_API_BASE=https://api.x.com

# ---------- Meta (Instagram + Facebook + WhatsApp) ----------
META_GRAPH_VERSION=v23.0
# Long-lived Page access token (pages_manage_posts, instagram_content_publish, ...)
META_PAGE_ACCESS_TOKEN=
# Instagram professional account id linked to the Page
IG_USER_ID=
IG_POLL_INTERVAL_MS=5000
IG_POLL_TIMEOUT_MS=300000
# Facebook Page id
FB_PAGE_ID=

# ---------- WhatsApp Cloud API ----------
WA_PHONE_NUMBER_ID=
# System-user token with whatsapp_business_messaging
WA_ACCESS_TOKEN=
# Shared secret for the webhook GET handshake (verifyWhatsAppWebhook)
WA_WEBHOOK_VERIFY_TOKEN=
# App secret for X-Hub-Signature-256 verification of webhook POSTs (verifyMetaSignature)
META_APP_SECRET=
# Approved templates: {"<name>": {"bodyParams": n, "language": "te", "urlButton": true, "urlPrefix": "https://openlens.app/story/", "disclosureInTemplate": true}}
WA_TEMPLATES={"daily_digest_te":{"bodyParams":1,"language":"te","urlButton":true,"urlPrefix":"https://openlens.app/story/","disclosureInTemplate":true}}
WA_SEND_INTERVAL_MS=100
WA_MAX_RECIPIENTS=1000

# ---------- FCM push (notifier) ----------
# Uses Application Default Credentials (Cloud Run service account / gcloud auth application-default login)
FCM_PROJECT_ID=

# ---------- HTTP behaviour / logging ----------
PUBLISHER_HTTP_TIMEOUT_MS=30000
PUBLISHER_HTTP_RETRIES=3
PUBLISHER_RETRY_BASE_MS=500
# silent | (anything else = JSON lines to stdout)
PUBLISHER_LOG=info
