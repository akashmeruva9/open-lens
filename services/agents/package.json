{
  "name": "@openlens/agents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts",
    "pipeline": "tsx src/cli.ts"
  },
  "dependencies": {
    "@google/genai": "*",
    "@openlens/config": "*",
    "@openlens/schemas": "*",
    "zod": "*"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  }
}