# Gemini (AI Studio key for local dev; use Vertex AI + ADC on Cloud Run)
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
# Model registry overrides. Verified 2026-10-12. Switch MODEL_REASONING to gemini-3.1-pro-preview once Pro quota (billing) is enabled.
MODEL_REASONING=gemini-3.8-flash
MODEL_FAST=gemini-3.8-flash
MODEL_TTS=gemini-3.8-flash-tts
MODEL_EMBED=gemini-embedding-2
MODEL_FALLBACK=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-flash-latest

# ---- The wire (automatic discovery) ----
# Local scheduler interval in minutes (0/unset = off). On Cloud Run, Cloud Scheduler calls POST /v1/internal/ingest.
INGEST_INTERVAL_MIN=10
INGEST_TOKEN=
# Comma-separated market codes (default: all JAPAC markets)
INGEST_MARKETS=
INGEST_GDELT=1
INGEST_LOOKBACK_MIN=30
INGEST_MAX_NEW=3
INGEST_MAX_UPDATES=3
INGEST_DAILY_RUNS=40
INGEST_CONCURRENCY=2
INGEST_MIN_PUBLISHERS=2
# off = every story waits for an editor; low_risk = publish low-risk stories with no blocking QA flags (labelled "not editor-reviewed")
AUTO_PUBLISH=off
# Languages to render narrated video for automatically (others render on demand from the studio)
AUTO_MEDIA_LANGS=en
