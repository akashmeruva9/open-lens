{
  "name": "@openlens/media-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts",
    "spike": "tsx src/spike.ts",
    "preview": "node --import tsx src/preview.ts",
    "preview:video": "node --import tsx src/previewvideo.ts",
    "voicetest": "TTS_LOCATION=us-central1 node --env-file-if-exists=../../.env --import tsx src/voicetest.ts",
    "portraits": "GOOGLE_CLOUD_LOCATION=global node --env-file-if-exists=../../.env --import tsx src/portraits.ts",
    "idle-clip": "GOOGLE_CLOUD_LOCATION=us-central1 node --env-file-if-exists=../../.env --import tsx src/idleclip.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "*",
    "@google/genai": "*",
    "@openlens/config": "*",
    "@openlens/schemas": "*",
    "toqr": "^0.1.1"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  }
}
