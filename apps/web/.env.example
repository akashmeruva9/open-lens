# Base URL of services/api (REST + SSE). Used by the reader (server + browser).
NEXT_PUBLIC_API_URL=http://localhost:8080
# On Vercel (vercel.json services): NEXT_PUBLIC_API_URL=/api. Server-side fetches use API_INTERNAL_URL, injected by the web -> api binding.
# Public origin used for share links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
