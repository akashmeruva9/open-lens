{
  "name": "@openlens/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "deps": "npm run build -w @openlens/schemas -w @openlens/client",
    "predev": "npm run deps",
    "dev": "next dev --port 3000",
    "prebuild": "npm run deps",
    "build": "next build",
    "start": "next start --port 3000",
    "pretypecheck": "npm run deps && next typegen",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@openlens/client": "*",
    "@openlens/schemas": "*",
    "hls.js": "1.7.3",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
