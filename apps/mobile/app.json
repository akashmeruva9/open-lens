{
  "expo": {
    "name": "OpenLens",
    "slug": "openlens",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "openlens",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0B1426",
    "primaryColor": "#38BDF8",
    "description": "OpenLens reader: every story backed by an inspectable claim & evidence ledger.",
    "ios": {
      "bundleIdentifier": "app.openlens.reader",
      "supportsTablet": true,
      "associatedDomains": ["applinks:openlens.app"],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "package": "app.openlens.reader",
      "adaptiveIcon": {
        "backgroundColor": "#0B1426",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "openlens.app", "pathPrefix": "/story/" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B1426",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": true,
          "supportsPictureInPicture": true
        }
      ],
      "expo-localization",
      [
        "expo-notifications",
        {
          "color": "#38BDF8"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "universalLinks": {
        "_comment": "Placeholder: host apple-app-site-association and assetlinks.json on openlens.app before enabling in production.",
        "host": "openlens.app",
        "pathPrefix": "/story/"
      }
    }
  }
}
